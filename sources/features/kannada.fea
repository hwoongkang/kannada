lookup KndaDealWithVowelSigns useExtension {
    lookupflag MarkAttachmentType @knda_vowelsigns;
    sub @knda_consonants' lookup KndaRemoveCrest aavowelsignknda';
    sub @knda_consonants' lookup KndaRemoveCrest auvowelsignknda';
    sub @knda_consonants' lookup KndaVowelLigature ivowelsignknda';
    sub @knda_consonants' lookup KndaVowelLigature evowelsignknda';
    sub [faknda ngaknda nyaknda rraknda uni0CF1 uni0CF2]' aavowelsignknda' lookup KndaAlternateVowelSigns;
    sub [faknda ngaknda nyaknda rraknda uni0CF1 uni0CF2]' [kasubscriptknda khasubscriptknda pasubscriptknda phasubscriptknda]' aavowelsignknda' lookup KndaAlternateVowelSigns;
    sub [faknda ngaknda nyaknda rraknda uni0CF1 uni0CF2]' evowelsignknda' lookup KndaAlternateVowelSigns;
    sub [faknda ngaknda nyaknda rraknda uni0CF1 uni0CF2]' [kasubscriptknda khasubscriptknda pasubscriptknda phasubscriptknda]' evowelsignknda' lookup KndaAlternateVowelSigns;
} KndaDealWithVowelSigns;

} abvs;

