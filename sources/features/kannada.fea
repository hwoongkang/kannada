# --------
# lookups
# --------

# MultipleSubstitution9
lookup KndaMultipleSubstitution9 useExtension {
    sub kassaknda by kaknda viramaknda ssaknda;
    sub janyaknda by jaknda viramaknda nyaknda;
} KndaMultipleSubstitution9;


# Swaps
lookup KndaSingleSubstitution10 useExtension {
    sub viramaknda by kasubscriptknda;
    sub kassaknda by ssasubscriptknda;
} KndaSingleSubstitution10;

lookup KndaSingleSubstitution11 useExtension {
    sub viramaknda by jasubscriptknda;
    sub janyaknda by nyasubscriptknda;
} KndaSingleSubstitution11;

lookup KndaSingleSubstitution13 useExtension {
    sub kaknda by kasubscriptknda;
    sub khaknda by khasubscriptknda;
    sub paknda by pasubscriptknda;
    sub phaknda by phasubscriptknda;
    sub raknda by rvocalicknda;
    sub rvocalicvowelsignknda by rephknda;
} KndaSingleSubstitution13;

lookup KndaSingleSubstitution23 useExtension {
    sub aavowelsignknda by phanuktasubscriptknda;
    sub ivowelsignknda by phanuktasubscriptknda;
    sub uvowelsignknda by phanuktasubscriptknda;
    sub uuvowelsignknda by phanuktasubscriptknda;
    sub evowelsignknda by phanuktasubscriptknda;
    sub auvowelsignknda by phanuktasubscriptknda;
} KndaSingleSubstitution23;

# Janukta/Phanukta <-> Vowel sign swaps

lookup KndaSingleSubstitution21 useExtension {
    sub januktasubscriptknda by auvowelsignknda;
    sub phanuktasubscriptknda by auvowelsignknda;
} KndaSingleSubstitution21;

lookup KndaSingleSubstitution19 useExtension {
    sub januktasubscriptknda by uvowelsignknda;
    sub phanuktasubscriptknda by uvowelsignknda;
} KndaSingleSubstitution19;

lookup KndaSingleSubstitution18 useExtension {
    sub januktasubscriptknda by evowelsignknda;
    sub phanuktasubscriptknda by evowelsignknda;
} KndaSingleSubstitution18;

lookup KndaSingleSubstitution17 useExtension {
    sub januktasubscriptknda by ivowelsignknda;
    sub phanuktasubscriptknda by ivowelsignknda;
} KndaSingleSubstitution17;

lookup KndaSingleSubstitution16 useExtension {
    sub januktasubscriptknda by aavowelsignknda;
    sub phanuktasubscriptknda by aavowelsignknda;
} KndaSingleSubstitution16;

lookup KndaSingleSubstitution22 useExtension {
    sub aavowelsignknda by januktasubscriptknda;
    sub ivowelsignknda by januktasubscriptknda;
    sub uvowelsignknda by januktasubscriptknda;
    sub uuvowelsignknda by januktasubscriptknda;
    sub evowelsignknda by januktasubscriptknda;
    sub auvowelsignknda by januktasubscriptknda;
} KndaSingleSubstitution22;

lookup KndaSingleSubstitution20 useExtension {
    sub januktasubscriptknda by uuvowelsignknda;
    sub phanuktasubscriptknda by uuvowelsignknda;
} KndaSingleSubstitution20;

# Anusvara/virsaga reph swaps, lengthmark uuvowelsign swap
lookup KndaSingleSubstitution37 useExtension {
    sub anusvaraknda by rephknda;
    sub visargaknda by rephknda;
    sub lengthmarkknda by uuvowelsignknda;
} KndaSingleSubstitution37;

lookup KndaSingleSubstitution38 useExtension {
    sub rephknda by anusvaraknda;
} KndaSingleSubstitution38;

lookup KndaSingleSubstitution39 useExtension {
    sub rephknda by visargaknda;
} KndaSingleSubstitution39;

lookup KndaSingleSubstitution40 useExtension {
    sub uuvowelsignknda by lengthmarkknda;
} KndaSingleSubstitution40;



# AlternateVowelSigns
